---
import Footer from "../layouts/Footer.astro";
import Header from "../layouts/Header.astro";
import PageShell from "../layouts/PageShell.astro";
import { impressumDetails, impressumEmailAddress } from "../legal/impressum.js";

const impressumPageUrl = new URL("/impressum", Astro.site ?? Astro.url).toString();
---

<PageShell
	canonicalUrl={impressumPageUrl}
	description="Impressum und Kontaktinformationen für echooff.dev."
	title="Impressum | echooff.dev"
>
	<Header />

	<main class="legal-page" lang="de">
		<article>
			<h1>Impressum</h1>

			<section aria-labelledby="impressum-details-heading">
				<h2 id="impressum-details-heading">Angaben gemäß § 5 DDG</h2>
				<address>
					{impressumDetails.legalName}
					<br />
					{
						impressumDetails.addressLines.map((addressLine, addressLineIndex) => (
							<Fragment>
								{addressLine}
								{addressLineIndex < impressumDetails.addressLines.length - 1 && <br />}
							</Fragment>
						))
					}
				</address>
			</section>

			<section aria-labelledby="contact-heading">
				<h2 id="contact-heading">Kontakt</h2>
				<p>
					E-Mail: <a href={`mailto:${impressumEmailAddress}`}>{impressumEmailAddress}</a>
				</p>
			</section>

			<section aria-labelledby="responsibility-heading">
				<h2 id="responsibility-heading">Redaktionell verantwortlich</h2>
				<p>{impressumDetails.legalName} (Anschrift wie oben)</p>
			</section>

			<section aria-labelledby="consumer-dispute-resolution-heading">
				<h2 id="consumer-dispute-resolution-heading">
					Verbraucherstreitbeilegung / Universalschlichtungsstelle
				</h2>
				<p>
					Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
					Verbraucherschlichtungsstelle teilzunehmen.
				</p>
			</section>
		</article>
	</main>

	<Footer />
</PageShell>

<style lang="scss">
	@use "sass:color";
	@use "../styles/variables";

	.legal-page {
		color: variables.$foreground;
		display: flex;
		flex-grow: 1;
		justify-content: center;
		padding: 2rem 0.5rem 3rem;
	}

	article {
		background-color: color.mix(variables.$selection, variables.$background, $weight: 32%);
		border: 1px solid variables.$selection;
		border-radius: 0.5rem;
		box-shadow:
			0 1.5rem 3rem rgba(variables.$background, 0.5),
			inset 0 1px 0 rgba(variables.$foreground, 0.04);
		padding: 1.5rem;
		width: min(100%, 56rem);
	}

	h1 {
		color: variables.$foreground;
		font-size: clamp(1.75rem, 3vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	section {
		margin-top: 2rem;
	}

	h2 {
		color: variables.$cyan;
		font-size: 1.1rem;
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: 0.75rem;
	}

	p,
	address {
		line-height: 1.8;
	}

	address {
		font-style: normal;
	}

	a {
		color: variables.$cyan;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;

		&:hover,
		&:focus-visible {
			color: variables.$purple;
		}
	}

	@media (min-width: variables.$small-width) {
		.legal-page {
			padding: 3rem 1.5rem 4rem;
		}

		article {
			padding: 2rem;
		}
	}
</style>
