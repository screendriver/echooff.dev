---
import pretzelSvg from "../assets/images/pretzel.svg";
---

<footer>
	<a class="footer-link footer-impressum" href="/impressum">Impressum</a>

	<p class="made-with">
		Made with
		<img src={pretzelSvg.src} alt="" loading="lazy" width={28} height={28} />
	</p>

	<a class="footer-link footer-side-quest" href="https://overkill.dev">side quest: overkill.dev</a>
</footer>

<style lang="scss">
	@use "../styles/variables";

	footer {
		align-items: center;
		border-top: 1px solid variables.$purple;
		display: flex;
		flex-direction: column;
		flex-shrink: 0;
		gap: 0.35rem;
		justify-content: center;
		min-height: 4rem;
		padding: 0.75rem 1rem;
	}

	.footer-link {
		flex: 0 0 auto;
		text-align: center;
	}

	.made-with {
		align-items: center;
		color: variables.$foreground;
		display: flex;
		font-size: 0.875rem;
		font-weight: 200;
		gap: 0.5rem;
		justify-content: center;
		line-height: 1;
		margin: 0;
	}

	img {
		display: block;
	}

	a {
		color: variables.$foreground;
		font-size: 0.75rem;
		font-weight: 200;
		line-height: 1;
		opacity: 0.7;
		text-decoration: none;

		&:hover {
			opacity: 1;
			text-decoration: none;
		}

		&:focus-visible {
			opacity: 1;
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 0.18em;
		}
	}

	@media (min-width: variables.$small-width) {
		footer {
			flex-direction: row;
			gap: 1rem;
			padding: 0 2rem;
		}

		.footer-link {
			flex: 1 1 0;
			min-width: 0;
		}

		.made-with {
			flex: 1 1 0;
			min-width: 0;
		}

		.footer-impressum {
			text-align: left;
		}

		.footer-side-quest {
			text-align: right;
		}
	}
</style>
